# ---------------------------------------------------------------------------
# SinergiaCRM (SuiteCRM 7.x) — API V8
# OJO: SinergiaCRM va sobre SuiteCRM 7.x, así que los endpoints son
#   {SINERGIA_URL}/Api/access_token   y   {SINERGIA_URL}/Api/V8/...
# SIN el prefijo /legacy/ (ese es de SuiteCRM 8.x).
# ---------------------------------------------------------------------------

# URL base de la instancia, sin barra final y SIN /Api
SINERGIA_URL=https://tuorganizacion.sinergiacrm.org

# Cliente OAuth2 creado en: Administración → OAuth2 Clients
SINERGIA_CLIENT_ID=
SINERGIA_CLIENT_SECRET=

# Usuario API dedicado (grant_type=password).
# Si los dejas vacíos se usa grant_type=client_credentials (el cliente OAuth2
# debe estar configurado para ese grant y con un usuario asociado).
SINERGIA_USERNAME=
SINERGIA_PASSWORD=

# ---------------------------------------------------------------------------
# Servidor MCP
# ---------------------------------------------------------------------------

# Secreto que los clientes MCP deben enviar en "Authorization: Bearer <secreto>".
# Genera uno largo y aleatorio, p.ej.:  openssl rand -hex 32
# Si está vacío, el servidor rechaza TODAS las peticiones con 401.
MCP_AUTH_SECRET=

# Escritura desactivada por defecto. Ponlo a "true" solo cuando quieras
# registrar create_entry / update_entry / set_relationship.
ALLOW_WRITES=false
